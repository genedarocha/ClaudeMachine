# Configuration for Automation 1: Daily Video Content Autopilot Engine
# Voxstar Ltd • Wiredvibeapp

# --- AI LLM Model Providers (Choose one or configure all) ---
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROK_API_KEY=your_xai_grok_api_key_here

# --- Video Engine Configuration ---
# Options: 'LT25' (Free/Local), 'SUNDANCE' (Fee/Local), 'GEMINI_VEO' (Cloud)
DEFAULT_VIDEO_ENGINE=LT25
LT25_LOCAL_ENDPOINT=http://localhost:7860/api/render
SUNDANCE_API_KEY=your_sundance_api_key_here
SUNDANCE_LOCAL_PORT=8080

# --- Brand & Channel Defaults ---
BRAND_NAME=Wiredvibeapp
BRAND_WEBSITE=https://wiredvibe.ai
MANDATORY_HASHTAGS=#voxstar #voxstar.ai #wiredvibeapp #atltrust #aitoolboard

# --- Social Media API Credentials ---
# 1. X.com (Twitter)
X_API_KEY=your_x_consumer_key
X_API_SECRET=your_x_consumer_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret

# 2. YouTube (Google OAuth / API Key)
YOUTUBE_CLIENT_SECRETS_FILE=client_secret_youtube.json
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# 3. LinkedIn Personal Profile (Gene Da Rocha)
LINKEDIN_PERSONAL_ACCESS_TOKEN=your_linkedin_personal_token
LINKEDIN_GENE_AUTHOR_URN=urn:li:person:YOUR_URN_HERE

# 4. LinkedIn Company Page (Wiredvibeapp)
LINKEDIN_COMPANY_ACCESS_TOKEN=your_linkedin_company_token
LINKEDIN_ORGANIZATION_URN=urn:li:organization:YOUR_ORG_ID

# 5. Facebook Company Page (Wiredvibeapp)
FACEBOOK_PAGE_ACCESS_TOKEN=your_fb_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# 6. TikTok (Wiredvibeapp account)
TIKTOK_ACCESS_TOKEN=your_tiktok_creator_token
TIKTOK_OPEN_ID=your_tiktok_open_id

# --- Database & Scheduler Settings ---
DATABASE_PATH=automation_videos.db
CSV_QUEUE_PATH=video_ideas_queue.csv
DAILY_RUN_TIME=08:00
LOOP_INTERVAL_HOURS=24
AUTO_RETRY_FAILED=true
MAX_CRITIQUE_LOOPS=3
