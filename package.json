  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^28.1.0",
    "oxlint": "^1.71.0",
    "turndown": "^7.2.4",
    "typescript": "~6.0.2",
    "undici": "^7.30.1",
    "vite": "^8.1.1"
  }
